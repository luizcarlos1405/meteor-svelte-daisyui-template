{
  "name": "meteor-svelte-template",
  "private": true,
  "scripts": {
    "start": "meteor run --port 3050",
    "test": "meteor test --once --driver-package meteortesting:mocha --port 3100",
    "test:unit": "mocha --import=tsx './imports/api/**/*.test.ts'",
    "test-app": "TEST_WATCH=1 meteor test --full-app --driver-package meteortesting:mocha",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "visualize": "meteor --production --extra-packages bundle-visualizer"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@swc/helpers": "^0.5.17",
    "dedent": "^1.7.2",
    "lucide-svelte": "^1.0.1",
    "meteor-node-stubs": "^1.2.12",
    "svelte-dnd-action": "^0.9.70",
    "svelte-spa-router": "^5.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@meteorjs/rspack": "^2.2.0",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@rspack/cli": "^1.7.12",
    "@rspack/core": "^1.7.12",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mocha": "^10.0.10",
    "daisyui": "^5.6.13",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "lefthook": "^2.1.9",
    "mocha": "^11.7.6",
    "postcss": "^8.5.16",
    "postcss-load-config": "^5.1.0",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "svelte-eslint-parser": "^1.8.0",
    "svelte-loader": "^3.2.4",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript-eslint": "^8.62.1"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.js"
    },
    "testModule": "tests/main.js",
    "modern": true
  }
}
